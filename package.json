{
  "name": "som-llm-selector",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "SOM \u2014 open-source LLM selector: filter 400+ models by modality, openness, price, cache pricing and benchmarks, then compare them.",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node --env-file-if-exists=.env server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "node scripts/build-catalog.mjs && tsc -b --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "catalog": "node --env-file-if-exists=.env scripts/build-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:frederico-kluser/som-llm-selector.git"
  },
  "bugs": {
    "url": "https://github.com/frederico-kluser/som-llm-selector/issues"
  },
  "homepage": "https://github.com/frederico-kluser/som-llm-selector#readme",
  "keywords": [
    "llm",
    "openrouter",
    "artificial-analysis",
    "model-selection",
    "benchmarks",
    "react",
    "vite",
    "dashboard"
  ]
}
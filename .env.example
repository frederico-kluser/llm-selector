# Copy to .env (git-ignored) for local development.
# Both keys are optional: the OpenRouter catalogue is public and the app works without them.

# Artificial Analysis — needed for benchmark indices, cache pricing and throughput.
# Kept server-side: the browser never sees this value when it is set here.
ARTIFICIAL_ANALYSIS_API_KEY=aa_your_key_here

# OpenRouter — only needed for account credits and to raise catalogue rate limits.
OPENROUTER_API_KEY=

# Overrides
# PORT=8899
# HOST=127.0.0.1
# SOM_PUBLIC_URL=http://localhost:5173

{
  "_doc": "Fontes do material do projeto para `coala.py sync`. rules: mode markdown|text|whole|pdf \u00b7 type episodic|semantic|procedural \u00b7 origin owner|agent|untrusted|system \u00b7 tags aceitam {stem} {name} {dir} {rule}; a primeira regra que apanha um ficheiro ganha. code: o cat\u00e1logo de c\u00f3digo (s\u00edmbolos por ficheiro) \u00e9 autom\u00e1tico \u2014 `include`/`exclude` s\u00e3o globs, `enabled: false` desliga. Ver references/instalar.md da coala-agent-skill.",
  "version": 2,
  "key_prefix": "proj",
  "path_prefix": "",
  "exclude": [],
  "rules": [
    {
      "name": "readme",
      "include": [
        "README.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,readme"
    },
    {
      "name": "raiz",
      "include": [
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "NOTICE.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,{stem}"
    },
    {
      "name": "research",
      "include": [
        "research/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "research,{stem}"
    },
    {
      "name": "security",
      "include": [
        "SECURITY.md",
        "CODE_OF_CONDUCT.md",
        "config.schema.json"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,{stem}"
    }
  ],
  "code": {
    "enabled": true,
    "include": [],
    "exclude": []
  },
  "graph": {
    "entities": [],
    "edges": []
  }
}